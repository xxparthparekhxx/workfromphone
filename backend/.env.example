# Server Configuration
# Binding anything other than a loopback address requires ACCESS_TOKEN to be
# set; the backend refuses to start otherwise.
HOST=127.0.0.1
PORT=8000
DEBUG=false
ACCESS_TOKEN=replace-with-a-random-32-byte-token
MAX_UPLOAD_BYTES=536870912

# App Metadata
APP_NAME="WorkFromPhone Backend"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# CORS Configuration (JSON array). List explicit origins only: a "*" entry
# is stripped at startup because it would expose the backend to any website.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
